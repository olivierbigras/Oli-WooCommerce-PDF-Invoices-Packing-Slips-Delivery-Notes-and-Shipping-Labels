#: oli-pdf-invoices-packing-slips.php
msgid "Oli PDF Invoices & Packing Slips for WooCommerce"
msgstr "Oli PDF Invoices & Packing Slips for WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: oli-pdf-invoices-packing-slips.php
msgid "https://olivierbigras.com/"
msgstr "https://olivierbigras.com/"

#. Description of the plugin
#: oli-pdf-invoices-packing-slips.php
msgid "Generate and print PDF invoices, packing slips, delivery notes, shipping labels, and credit notes for WooCommerce orders. Customize templates, auto-attach to emails, and manage sequential invoice numbering."
msgstr "Générez et imprimez des factures PDF, bons de préparation, bons de livraison, étiquettes d’expédition et avoirs pour les commandes WooCommerce. Personnalisez les modèles, joignez-les aux e-mails et gérez la numérotation séquentielle."

#. Author of the plugin
#: oli-pdf-invoices-packing-slips.php
msgid "Olivier Bigras"
msgstr "Olivier Bigras"

