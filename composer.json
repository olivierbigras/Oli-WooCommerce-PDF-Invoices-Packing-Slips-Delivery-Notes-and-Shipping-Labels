{
    "name": "olivierbigras/oli-pdf-invoices-packing-slips",
    "description": "Oli PDF Invoices & Packing Slips for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Olivier Bigras",
            "homepage": "https://olivierbigras.com/"
        }
    ],
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^2.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "scripts": {
        "phpcs": "phpcs --standard=phpcs.xml",
        "phpcbf": "phpcbf --standard=phpcs.xml",
        "lint": "find . -name '*.php' ! -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "test": "php tests/run-webtoffee-format-tests.php && php tests/run-upgrade-and-guardrail-tests.php",
        "build": "bash bin/build-release.sh"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
