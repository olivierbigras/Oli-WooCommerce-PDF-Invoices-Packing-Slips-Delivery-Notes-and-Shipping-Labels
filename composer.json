{
    "name": "olivierbigras/oli-pdf-invoices-packing-slips",
    "description": "Oli PDF Invoices & Packing Slips for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/olivierbigras/Oli-WooCommerce-PDF-Invoices-Packing-Slips-Delivery-Notes-and-Shipping-Labels",
    "authors": [
        {
            "name": "Olivier Bigras",
            "homepage": "https://olivierbigras.com/"
        }
    ],
    "support": {
        "issues": "https://github.com/olivierbigras/Oli-WooCommerce-PDF-Invoices-Packing-Slips-Delivery-Notes-and-Shipping-Labels/issues",
        "source": "https://github.com/olivierbigras/Oli-WooCommerce-PDF-Invoices-Packing-Slips-Delivery-Notes-and-Shipping-Labels"
    },
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^3.1.6"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "scripts": {
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=phpcs.xml.dist",
        "lint": "find . -name '*.php' ! -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "test": "php tests/run-webtoffee-format-tests.php && php tests/run-upgrade-and-guardrail-tests.php && php tests/run-logo-fit-tests.php",
        "build": "bash tools/build-zip.sh"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
